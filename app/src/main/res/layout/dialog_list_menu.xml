<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#1E1E24"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/menuMediaTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Media Title"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="20dp"
        android:singleLine="true"
        android:ellipsize="marquee"/>

    <TextView
        android:id="@+id/menuConvertToMp3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🎧 Convert to MP3"
        android:textColor="#E0E0E0"
        android:textSize="16sp"
        android:paddingVertical="12dp"/>

    <TextView
        android:id="@+id/menuLockVault"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🔒 Move to Private Vault"
        android:textColor="#E0E0E0"
        android:textSize="16sp"
        android:paddingVertical="12dp"/>

    <TextView
        android:id="@+id/menuShare"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📤 Share"
        android:textColor="#E0E0E0"
        android:textSize="16sp"
        android:paddingVertical="12dp"/>

    <TextView
        android:id="@+id/menuDelete"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🗑️ Delete"
        android:textColor="#FF5252"
        android:textSize="16sp"
        android:paddingVertical="12dp"/>
</LinearLayout>
