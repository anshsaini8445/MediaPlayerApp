<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#1B1C26"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Media Name -->
    <TextView
        android:id="@+id/menuMediaTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Media Title"
        android:textColor="#00E5FF"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"
        android:singleLine="true"
        android:ellipsize="marquee"/>

    <!-- PLAYit Style Options -->
    <TextView
        android:id="@+id/menuShare"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📤 Share"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:paddingVertical="14dp"/>

    <TextView
        android:id="@+id/menuPlayAudio"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🎧 Play as Audio"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:paddingVertical="14dp"/>

    <TextView
        android:id="@+id/menuLockVault"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🔒 Move to Privacy Folder"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:paddingVertical="14dp"/>

    <TextView
        android:id="@+id/menuDelete"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🗑️ Delete"
        android:textColor="#FF4444"
        android:textSize="16sp"
        android:paddingVertical="14dp"/>
</LinearLayout>
