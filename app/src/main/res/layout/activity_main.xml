<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D0D1A">

    <!-- Top Header & Tabs -->
    <LinearLayout
        android:id="@+id/topHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#1A1A24"
        android:paddingTop="16dp">
        
        <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingHorizontal="16dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="MAX Player" android:textColor="#FFFFFF" android:textSize="22sp" android:textStyle="bold"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="PRO" android:textColor="#000000" android:background="#FF671F" android:textStyle="bold" android:paddingHorizontal="6dp" android:paddingVertical="2dp" android:layout_marginStart="130dp" android:layout_marginTop="4dp"/>
            <TextView android:id="@+id/btnViewToggle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="☰" android:textColor="#FFFFFF" android:textSize="24sp" android:layout_alignParentEnd="true"/>
        </RelativeLayout>

        <LinearLayout android:id="@+id/subTabs" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="16dp">
            <TextView android:id="@+id/tabVideo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Videos" android:textColor="#00E5FF" android:textSize="16sp" android:textStyle="bold" android:layout_marginEnd="24dp"/>
            <TextView android:id="@+id/tabFolder" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Folders" android:textColor="#AAAAAA" android:textSize="16sp" android:textStyle="bold" android:layout_marginEnd="24dp"/>
            <TextView android:id="@+id/tabPlaylist" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Playlists" android:textColor="#AAAAAA" android:textSize="16sp" android:textStyle="bold"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Main Content List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/topHeader"
        android:layout_above="@id/bottomSearchBarContainer"
        android:clipToPadding="false"
        android:paddingBottom="10dp"/>

    <!-- Settings / ME Layout -->
    <ScrollView
        android:id="@+id/settingsLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/topHeader"
        android:layout_above="@id/bottomNav"
        android:visibility="gone"
        android:background="#0D0D1A">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="#FF671F" android:padding="20dp" android:gravity="center" android:layout_margin="16dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="👑 Upgrade to PRO" android:textColor="#000000" android:textSize="20sp" android:textStyle="bold"/>
            </LinearLayout>
            
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:weightSum="3" android:padding="16dp">
                <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center">
                    <ImageView android:layout_width="48dp" android:layout_height="48dp" android:src="@android:drawable/ic_menu_camera" android:tint="#00E5FF"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="MP3 Convert" android:textColor="#FFFFFF" android:layout_marginTop="8dp"/>
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center">
                    <ImageView android:layout_width="48dp" android:layout_height="48dp" android:src="@android:drawable/ic_menu_gallery" android:tint="#FF671F"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Themes" android:textColor="#FFFFFF" android:layout_marginTop="8dp"/>
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center">
                    <ImageView android:layout_width="48dp" android:layout_height="48dp" android:src="@android:drawable/ic_secure" android:tint="#FFD700"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Vault" android:textColor="#FFFFFF" android:layout_marginTop="8dp"/>
                </LinearLayout>
            </LinearLayout>
            
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Equalizer" android:textColor="#FFFFFF" android:textSize="18sp" android:padding="20dp" android:background="?attr/selectableItemBackground"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Recycle Bin" android:textColor="#FFFFFF" android:textSize="18sp" android:padding="20dp" android:background="?attr/selectableItemBackground"/>
        </LinearLayout>
    </ScrollView>

    <!-- Bottom Search Bar (Just above bottom navigation) -->
    <LinearLayout
        android:id="@+id/bottomSearchBarContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@id/bottomNav"
        android:background="#1A1A24"
        android:padding="10dp">
        
        <EditText
            android:id="@+id/bottomSearchBar"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="#333333"
            android:hint="Search audio, video..."
            android:textColorHint="#888888"
            android:textColor="#FFFFFF"
            android:paddingHorizontal="16dp"
            android:drawableStart="@android:drawable/ic_menu_search"
            android:drawablePadding="8dp"
            android:singleLine="true"/>
    </LinearLayout>

    <!-- Bottom Navigation -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_alignParentBottom="true"
        android:background="#1A1A24"
        app:itemIconTint="#00E5FF"
        app:itemTextColor="#00E5FF"
        app:menu="@menu/bottom_nav_menu" />
</RelativeLayout>
