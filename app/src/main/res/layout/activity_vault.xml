<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D0D1A"
    android:orientation="vertical"
    android:padding="32dp"
    android:gravity="center">

    <ImageView
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:src="@android:drawable/ic_secure"
        android:tint="#FF671F"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Private Vault"
        android:textColor="#FFFFFF"
        android:textSize="26sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Enter 4-Digit PIN to access hidden media"
        android:textColor="#AAAAAA"
        android:textSize="14sp"
        android:layout_marginBottom="32dp"/>

    <EditText
        android:id="@+id/etVaultPin"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:inputType="numberPassword"
        android:maxLength="4"
        android:textSize="24sp"
        android:textColor="#FFFFFF"
        android:textColorHint="#555555"
        android:hint="••••"
        android:gravity="center"
        android:letterSpacing="0.5"
        android:backgroundTint="#00E5FF"
        android:layout_marginBottom="32dp"/>

    <Button
        android:id="@+id/btnUnlockVault"
        android:layout_width="200dp"
        android:layout_height="50dp"
        android:text="UNLOCK"
        android:backgroundTint="#FF671F"
        android:textColor="#FFFFFF"
        android:textStyle="bold"/>
</LinearLayout>
